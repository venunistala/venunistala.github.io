# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# Generated by CI from a real run, never committed or hand-edited. Absent
# locally is the correct state: the strip renders nothing without a run.
/public/quality.json

# Machine-readable run reports, kept out of Playwright's own outputDir
# because Playwright wipes that directory when a run starts — which silently
# deleted the Vitest report and cost quality.json its test count.
/reports/

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
